===== style.css =====
/* Generated by Genesis+ 0.9.0. This file is replaced on every build. */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
    Arial, sans-serif;
  font-size: 1.0625rem;
  line-height: 1.6;
  color: #202124;
  background-color: #ffffff;
}

/* The page content. Children are stacked like a column. */
main {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  width: 100%;
  max-width: 960px;
  margin-inline: auto;
  padding: 2.5rem 1.25rem;
}

/* Layouts */
.column,
.row {
  display: flex;
  gap: 1rem;
  min-width: 0;
}

.column {
  flex-direction: column;
}

.row {
  flex-direction: row;
}

/* Row children share the space equally unless they have a width. */
.row > * {
  flex: 1 1 0;
  min-width: 0;
}

.row > .sized {
  flex: 0 1 auto;
}

.row > a {
  flex: 0 0 auto;
}

/* Alignment */
.align-left {
  text-align: left;
}

.align-center {
  text-align: center;
}

.align-right {
  text-align: right;
}

.row.align-center {
  justify-content: center;
}

.row.align-right {
  justify-content: flex-end;
}

.column.align-center > a,
.column.align-center > img {
  margin-inline: auto;
}

.column.align-right > a,
.column.align-right > img {
  margin-left: auto;
}

/* Text */
h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 0;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
  overflow-wrap: anywhere;
}

h1 {
  font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
}

h2 {
  font-size: clamp(1.6rem, 1.25rem + 1.8vw, 2.4rem);
}

h3 {
  font-size: 1.5rem;
}

h4 {
  font-size: 1.25rem;
}

h5 {
  font-size: 1.1rem;
}

h6 {
  font-size: 1rem;
}

p {
  margin: 0;
  overflow-wrap: anywhere;
}

/* Links and buttons */
a {
  width: fit-content;
  max-width: 100%;
  color: #6d28d9;
  text-underline-offset: 0.15em;
  overflow-wrap: anywhere;
}

a:hover {
  color: #5b21b6;
}

a:focus-visible {
  outline: 3px solid #a78bfa;
  outline-offset: 2px;
}

.button {
  display: inline-block;
  padding: 0.7em 1.4em;
  border-radius: 0.5rem;
  background-color: #7c3aed;
  color: #ffffff;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
}

.button:hover {
  color: #ffffff;
  filter: brightness(1.1);
}

/* Images */
img {
  display: block;
  max-width: 100%;
  height: auto;
}

/* Small screens: rows stack vertically and their sized children use the full width. */
@media (max-width: 640px) {
  main {
    padding: 1.5rem 1rem;
  }

  .row {
    flex-direction: column;
  }

  .row > * {
    flex: 0 0 auto;
  }

  .row > .sized {
    width: 100% !important;
  }

  .row.align-center {
    align-items: center;
  }

  .row.align-right {
    align-items: flex-end;
  }
}
